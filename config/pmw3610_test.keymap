#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* Uma unica tecla (kscan de 1 posicao). So pra o build ser valido.
             * O movimento do mouse vem do sensor PMW3610, nao do keymap. */
            bindings = <&kp A>;
        };
    };
};
