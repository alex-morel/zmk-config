#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* 6 botoes da trackball (kscan-gpio-direct, ver overlay) --
             * O movimento do mouse vem do sensor PMW3610, so os cliques
             * passam pelo keymap. Mesma ordem MB3/MB1/MB2 ja usada nas
             * thumb keys do splitkb.keymap (meio/esquerdo/direito),
             * duplicada nos dois grupos fisicos (A e B) pra dar acesso
             * aos 3 cliques dos dois lados da bola. AJUSTAR se quiser
             * outra combinacao. */
            bindings = <&mkp MB3 &mkp MB1 &mkp MB2   &mkp MB3 &mkp MB1 &mkp MB2>;
        };
    };
};
