#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * Shield de teste do sensor optico PMW3610DM-SUDU, mouse USB standalone.
 * Ver "pmw3610 esquema eletrico.svg" na raiz do projeto pra fiacao completa.
 *
 * PMW3610 e SPI MEIO-DUPLEX: uma unica linha SDIO faz MOSI e MISO. Por isso
 * NAO da pra usar o &pro_micro_spi padrao (que assume MOSI/MISO em pinos
 * separados) -- este overlay define um barramento SPI3 dedicado, com o
 * MESMO psel em MOSI e MISO. Mesma tecnica ja usada na tela do dongle
 * (splitkb_dongle.overlay), so que aqui os dois psels apontam pro mesmo pino
 * (D16) em vez de dois pinos diferentes.
 *
 *   D15 -> SCLK   D16 -> SDIO (MOSI=MISO)   D10 -> nCS   D9 -> MOTION (irq)
 *   3V3 -> VIN    GND -> GND   nRESET -> nao conectado (driver reseta via SPI)
 */

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                    <NRF_PSEL(SPIM_MISO, 0, 10)>;
            nordic,drive-mode = <NRF_DRIVE_H0H1>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                    <NRF_PSEL(SPIM_MISO, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi3 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&pro_micro 10 GPIO_ACTIVE_LOW>;    /* D10 = nCS */

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;    /* teto do PMW3610 (datasheet) */
        irq-gpios = <&pro_micro 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;   /* D9 = MOTION */
        cpi = <600>;                      /* 200..3200, passo 200 -- ajustar ao gosto */
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        // swap-xy;    /* descomente se X/Y saírem trocados */
        // invert-x;
        // invert-y;   /* datasheet: eixo Y bruto e "pra cima = positivo";
                        // a maioria dos SOs espera invertido (ver esquema) */
    };
};

/ {
    /* kscan minimo (1 tecla, nao fiada) so pra o ZMK compilar/bootar --
     * igual ao jstest. O foco deste build e testar o sensor, nao teclas. */
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios = <&pro_micro 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };
};
